# Lucy OS - Package list for x86_64

# Base system
base
linux
linux-firmware
linux-headers

# System tools
arch-install-scripts
base-devel
sudo
vim
nano
less
which
tree
git
curl
wget
openssh
networkmanager
wpa_supplicant
dialog
wireless_tools
netctl

# Python and Rust
python
python-pip
python-pygments
python-psutil
rust
maturin

# AI/ML dependencies
python-pydantic
python-openai

# Display server
xorg-server
xorg-xinit
xorg-server-xvfb
mesa
xf86-video-amdgpu
xf86-video-ati
xf86-video-intel
xf86-video-nouveau
xf86-video-fbdev

# Desktop environment
lxde
lxde-common
openbox
lxterminal
pcmanfm

# Live wallpaper (X11 video background via lucy-wallpaper)
mpv
xdotool
xorg-xprop

# USB persistence (partitioning for live USB cow store)
parted

# Essential app suite (out-of-the-box productivity)
chromium
alacritty
thunar
thunar-archive-plugin
thunar-media-tags-plugin
thunar-volman
gvfs
gvfs-mtp
tumbler
ffmpegthumbnailer

# Bluetooth (Control Center toggle)
bluez
bluez-utils

# VPN / proxy engine (sing-box, Clash API for the GUI widget)
sing-box

# Flatpak / Flathub integration (v0.4.0)
# flatpak pulls bubblewrap + ostree; the portals let sandboxed apps reach the
# desktop (file pickers, notifications, URL opening under openbox/LXDE).
flatpak
xdg-desktop-portal
xdg-desktop-portal-gtk
xdg-user-dirs

# Hardware video acceleration (Firefox VA-API, Celluloid/mpv)
# mesa already ships the Radeon VA-API driver; Intel Gen8+ needs the media
# driver, and libva/libvdpau are the runtime + diagnostics.
libva
libva-utils
libvdpau
intel-media-driver

# Core pre-installed applications (v0.4.0)
firefox
code
celluloid

# Boot loader
syslinux
mtools

# Tauri dependencies
gtk3
gdk-pixbuf2
librsvg

# System monitoring
htop
sysstat
iotop

# Additional utilities
zip
unzip
p7zip
tar
rsync
htop
strace
lsof
usbutils
pciutils
