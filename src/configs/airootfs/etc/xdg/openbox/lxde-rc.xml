<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <desktop>
    <number>1</number>
    <names>
      <name>Desktop 1</name>
    </names>
    <popupTime>0</popupTime>
  </desktop>

  <applications>
    <desktops>
      <desktop name="Desktop 1">
        <wallpaper>/usr/share/wallpapers/wallpaper.jpg</wallpaper>
      </desktop>
    </desktops>
  </applications>

  <!--
    Keyboard bindings.

    Super+Space is reserved for the Lucy Command Palette (registered as a
    global shortcut by the Tauri shell — see src-tauri/src/lib.rs). It is
    deliberately NOT bound here, because two owners of the same key would
    fight over it.

    Super+Shift+Space flips the input layout between English (US) and the
    optional Amharic (Ethiopic) layout (Week 4). Both layouts stay in the
    group so grp:alt_shift_toggle also works. English remains the system
    default; Amharic is never activated unless the user asks for it.
  -->
  <keyboard>
    <keybind key="Super+Shift+space">
      <action name="Execute">
        <command>/usr/local/bin/lucy-keyboard toggle</command>
        <startupnotify>
          <enabled>false</enabled>
        </startupnotify>
      </action>
    </keybind>
  </keyboard>
</openbox_config>
