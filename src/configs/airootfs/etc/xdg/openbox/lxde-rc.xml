<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <desktop>
    <number>1</number>
    <names>
      <name>Desktop 1</name>
    </names>
    <popupTime>0</popupTime>
  </desktop>

  <applications>
    <desktops>
      <desktop name="Desktop 1">
        <wallpaper>/usr/share/wallpapers/wallpaper.jpg</wallpaper>
      </desktop>
    </desktops>
  </applications>

  <!--
    Week 4 (optional Amharic/Ge'ez localization).

    Super+Space flips the input layout between English (US) and the optional
    Amharic (Ethiopic) layout. Both layouts stay in the group so Openbox's own
    grp:alt_shift_toggle also works. Nothing here changes the default language:
    English remains the system default and Amharic is never activated unless
    the user presses this binding (or uses the TopBar / Settings toggle).
  -->
  <keyboard>
    <keybind key="Super+space">
      <action name="Execute">
        <command>/usr/local/bin/lucy-keyboard toggle</command>
        <startupnotify>
          <enabled>false</enabled>
        </startupnotify>
      </action>
    </keybind>
  </keyboard>
</openbox_config>
