[Unit]
Description=Lucy OS Auto-Healing Daemon (resource watchdog + instant rollback)
After=network.target multi-user.target
Before=graphical-session-pre.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 -m lucy_agent.autoheal
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# The rollback engine writes boot state and rollback requests, creates
# Btrfs snapshots under /.snapshots, and clears cache/rotates logs.
ProtectHome=true
ReadWritePaths=/var/log/lucy /var/cache /var/lib/lucy /.snapshots

[Install]
WantedBy=multi-user.target
