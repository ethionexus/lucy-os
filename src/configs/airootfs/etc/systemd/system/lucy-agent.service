[Unit]
Description=Lucy OS AI Agent Daemon
After=network.target multi-user.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 -m lucy_agent.daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/lucy

[Install]
WantedBy=multi-user.target
